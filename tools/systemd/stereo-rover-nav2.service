[Unit]
Description=Rover Nav2 navigation stack (Project #2)
PartOf=stereo-rover-bringup.service
After=stereo-rover-bringup.service

[Service]
Type=simple
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source %h/stereo_ws/install/setup.bash && export ROS_LOCALHOST_ONLY=1 && exec ros2 launch nav2_bringup navigation_launch.py use_sim_time:=false params_file:=%h/stereo_ws/src/robot_description/config/nav2_params.yaml'
Environment=PYTHONUNBUFFERED=1
KillSignal=SIGINT
TimeoutStopSec=20
Restart=no
