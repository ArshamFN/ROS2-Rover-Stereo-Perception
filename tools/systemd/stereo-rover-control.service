[Unit]
Description=Rover pendant control node (Project #2)

[Service]
Type=simple
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source %h/stereo_ws/install/setup.bash && export ROS_LOCALHOST_ONLY=1 && exec ros2 run pendant_bridge control_node --ros-args -p allow_poweroff:=true'
Environment=PYTHONUNBUFFERED=1
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
